{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "UV_PROJECT_ENVIRONMENT=/tmp/uv-venv uv run python -m pygbag --build main.py",
  "outputDirectory": "build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*).apk",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ]
}
